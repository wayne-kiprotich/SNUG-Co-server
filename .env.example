# Copy to .env. Never commit .env.

# Required. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to 1 only on your own machine. It turns off Secure cookies and shows debug pages.
FLASK_DEBUG=0

# SQLite is used when this is empty. For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/snug
DATABASE_URL=

# Where uploaded photos are stored, and the URL prefix they are served from.
# Use a persistent disk in production.
UPLOAD_DIR=
UPLOAD_URL_BASE=/uploads

# Extra origins allowed to call the admin API (comma separated). Leave empty when the
# site and API share one domain, which is the recommended setup.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (for correct client IPs and HTTPS detection).
TRUSTED_PROXIES=0
