# Copy to .env. Never commit .env.

# Required. Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Set to 1 only on your own machine. It turns off Secure cookies and shows debug pages.
FLASK_DEBUG=0

# SQLite is used when this is empty. For PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/snug
DATABASE_URL=

# Where uploaded photos are stored when Supabase Storage (below) isn't set, and the
# URL prefix they're served from. A plain Render disk has no persistence on the free
# tier, so this is only a fallback for local development.
UPLOAD_DIR=
UPLOAD_URL_BASE=/uploads

# Supabase Storage for photos. Create a public bucket (Storage > New bucket, "Public
# bucket" on) and use the service_role key (Project Settings > API), not the anon key.
# Leave both empty to use local disk instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=product-photos

# The client's deployed origin(s), comma separated, when it's hosted separately from
# this API (e.g. the client on Vercel, this API on Render). Needed for CORS and for the
# admin's sign-in cookie to work cross-site. Leave empty when client and API share one
# domain, which needs no extra setup.
ALLOWED_ORIGINS=

# Number of reverse proxies in front of the app (for correct client IPs and HTTPS detection).
TRUSTED_PROXIES=0
